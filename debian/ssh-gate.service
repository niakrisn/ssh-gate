[Unit]
Description=ssh-gate SSH tunnel with SOCKS5 and HTTP proxy
Documentation=https://github.com/niakrisn/ssh-gate
Wants=network-online.target
After=network-online.target

[Service]
# The daemon reports READY=1 once its listeners are open (it does not wait
# for the tunnel) and keeps the Status: line of systemctl status current:
# not configured, connecting, key not accepted, connected and so on.
Type=notify
ExecStart=/usr/bin/ssh-gate
# Declared before EnvironmentFile so that /etc/default/ssh-gate wins if the
# user sets DATA_DIR there.
Environment=DATA_DIR=/var/lib/ssh-gate
EnvironmentFile=-/etc/default/ssh-gate
DynamicUser=yes
StateDirectory=ssh-gate
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
# The Go runtime reads only /proc/self (cgroup limits for GOMAXPROCS).
ProtectProc=invisible
ProcSubset=pid
# Go compiles ahead of time: no writable and executable memory is needed.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
DevicePolicy=closed
UMask=0077
# journald drops lines over 10000 per 30 s per unit by default; the access
# log writes one line per connection, so a busy proxy would lose lines.
LogRateLimitIntervalSec=30s
LogRateLimitBurst=50000
KillSignal=SIGTERM
TimeoutStopSec=15
# An empty SSH_HOST or SSH_USER is not an error: the daemon runs and its
# status line asks for the config. Every startup error (a bad value, a busy
# port, an unreadable key) exits with 78, which a restart cannot fix, so
# the unit stays failed instead of restarting in a loop. Restart covers
# crashes only.
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=3s

[Install]
WantedBy=multi-user.target
