# VPS access
SSH_HOST=
SSH_PORT=22
SSH_USER=

# Max duration of a single destination dial through the tunnel (Go duration,
# must be positive and below 10m — the connection history window). A dial to
# a blackholed host fails with a deadline error instead of hanging; default 30s.
SSH_DIAL_TIMEOUT=30s

# Proxy modes: socks5, http (comma-separated)
PROXY_MODES=socks5

# Listen addresses (inside container). Comma-separated for several, e.g.
# SOCKS5_LISTEN=0.0.0.0:1080,10.0.0.5:1081 — one proxy server per address.
# Extra addresses also need their own line in the compose "ports" mapping.
SOCKS5_LISTEN=0.0.0.0:1080
HTTP_LISTEN=0.0.0.0:3128

# Health + Web UI listen address (inside container; must be non-loopback for
# the compose port mapping — the host side stays loopback via the compose
# "ports" binding). This file seeds compose variable interpolation, so the
# value here overrides the compose default.
HEALTH_LISTEN=0.0.0.0:9090

# Extra Host names for the Web UI and API (comma-separated, no port), for
# opening the UI under a LAN name or address. localhost, 127.0.0.1 and ::1
# are always allowed; other Host headers get 403 (DNS rebinding guard).
UI_ALLOWED_HOSTS=

# Limit of concurrent client connections over all proxy listeners; a
# connection over the limit is closed at once. 0 disables the limit.
MAX_CONNECTIONS=4096

# Direct routing rules (optional, comma-separated). ip: rules are matched on
# the DoH answer, so intranet names unknown to public DNS need a domain rule.
# Tunnel names that resolve only to private addresses are refused.
# A backslash in this file is literal — write re:\.ru$ with ONE backslash
# (a doubled re:\\.ru$ would match a literal backslash and never fire).
# Example: DIRECT_RULES=re:\.ru$,ip:10.0.0.0/8,internal.local
DIRECT_RULES=

# Direct dial IP family: ipv4, ipv6, both
DIRECT_IP_FAMILY=ipv4

# DNS-over-HTTPS endpoint for tunnel destinations, queried through the SSH
# tunnel (direct destinations keep using local DNS). Definitive DoH answers,
# including NXDOMAIN, are authoritative; the local resolver is a fallback
# only while the endpoint is unreachable. An empty DOH_HOST disables DoH.
# Caveat: compose interpolates ${DOH_HOST:-cloudflare-dns.com}, so an empty
# value under compose becomes the default; to disable DoH there, delete the
# DOH_HOST line from this file (deb/systemd: just omit the variable).
DOH_HOST=cloudflare-dns.com

# Log level: debug, info, warn, error
LOG_LEVEL=warn

# SSH tunnel liveness period (Go duration). Drives both OS TCP keepalive
# (idle period) and the SSH-layer keepalive@openssh.com probe that drops a
# stuck-but-TCP-alive transport. 0 disables both. OS-side worst-case dead
# path detection through NAT/firewall = SSH_KEEPALIVE_PERIOD +
# SSH_KEEPALIVE_INTERVAL x SSH_KEEPALIVE_PROBES (defaults: 10s + 1s x 5 =
# 15s); an unanswered SSH probe drops the tunnel within ~2 x period.
SSH_KEEPALIVE_PERIOD=10s

# Keepalive probe retransmission interval (Go duration, rounded to whole
# seconds; 0 keeps the kernel default of 75s).
SSH_KEEPALIVE_INTERVAL=1s

# Number of unanswered keepalive probes before the connection is declared
# dead (integer; 0 keeps the kernel default of 9).
SSH_KEEPALIVE_PROBES=5
