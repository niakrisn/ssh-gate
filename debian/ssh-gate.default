# ssh-gate configuration, read by systemd through EnvironmentFile.
#
# This file is NOT a shell script: only KEY=value lines, no "export", no
# command substitution. Apply changes with: systemctl restart ssh-gate

# VPS access. Required: while SSH_HOST or SSH_USER is empty the service runs
# with the proxies off and "systemctl status ssh-gate" asks for them.
# SSH_HOST: IPv4 address or a name with an A record (the tunnel connects over
# IPv4 only).
SSH_HOST=
SSH_PORT=22
SSH_USER=

# Max duration of a single destination dial through the tunnel (Go duration,
# must be positive and below 10m - the connection history window). A dial to
# a blackholed host fails with a deadline error instead of hanging.
SSH_DIAL_TIMEOUT=30s

# Proxy modes: socks5, http (comma-separated)
PROXY_MODES=socks5

# Listen addresses. Loopback by default; set 0.0.0.0 to serve the whole
# network. Comma-separated for several, e.g. 127.0.0.1:1080,0.0.0.0:1081 -
# one proxy server per address. The Web UI and /healthz are served on
# HEALTH_LISTEN.
SOCKS5_LISTEN=127.0.0.1:1080
HTTP_LISTEN=127.0.0.1:3128
HEALTH_LISTEN=127.0.0.1:9090

# Extra Host names for the Web UI and API (comma-separated, no port), needed
# when HEALTH_LISTEN serves the network and the UI is opened under a LAN name
# or address. localhost, 127.0.0.1, ::1 and the HEALTH_LISTEN host are always
# allowed; other Host headers get 403 (DNS rebinding guard).
UI_ALLOWED_HOSTS=

# Limit of concurrent client connections over all proxy listeners. 0 disables
# the limit.
MAX_CONNECTIONS=4096

# Directory for the generated SSH key pair and known_hosts. The unit already
# sets it to /var/lib/ssh-gate, which systemd creates and owns; uncomment only
# to point somewhere else, and make sure the service can write there.
#DATA_DIR=/var/lib/ssh-gate

# Direct routing rules (optional, comma-separated). ip: rules are matched on
# the DoH answer, so intranet names unknown to public DNS need a domain rule.
# Tunnel names that resolve only to private addresses are refused. Example:
# DIRECT_RULES=ip:10.0.0.0/8,internal.local
DIRECT_RULES=

# Direct dial IP family: ipv4, ipv6, both
DIRECT_IP_FAMILY=ipv4

# DNS-over-HTTPS endpoint for tunnel destinations, queried through the SSH
# tunnel (direct destinations keep using local DNS). Empty disables DoH.
# Hostname only, port 443 only.
DOH_HOST=cloudflare-dns.com

# Log level of the service log: debug, info, warn, error
LOG_LEVEL=warn

# Access log: one line per proxied connection (client, destination, route,
# bytes, duration, result). on or off; LOG_LEVEL does not affect it. A failed
# connection has result resolve_error, dial_error or relay_error; the error
# text is a warning in the service log with the same conn_id. Both land in
# the journal under their own identifiers:
#   journalctl -u ssh-gate -t ssh-gate-access   access log
#   journalctl -u ssh-gate -t ssh-gate -p warning   service warnings and errors
ACCESS_LOG=on

# TCP keepalive for the SSH tunnel (Go duration). 0 disables OS keepalive.
# Worst-case dead-path detection = SSH_KEEPALIVE_PERIOD +
# SSH_KEEPALIVE_INTERVAL x SSH_KEEPALIVE_PROBES.
SSH_KEEPALIVE_PERIOD=10s
SSH_KEEPALIVE_INTERVAL=1s
SSH_KEEPALIVE_PROBES=5
