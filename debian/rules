#!/usr/bin/make -f
# Build the package the way the distribution does: dpkg-buildpackage drives dh
# (debhelper), which installs the unit file, YAML config and systemd snippets.
#
# Only the compile step is overridden. It uses the Go toolchain from the build
# environment because the golang packages in the target distributions are older
# than the "go" directive in go.mod. Override with make -e GO=/path/to/go.

include /usr/share/dpkg/default.mk

GO ?= go
# dpkg and Go agree on amd64 and arm64 spellings, so the host arch passes through.
GOARCH ?= $(DEB_HOST_ARCH)
export GO GOARCH
export CGO_ENABLED := 0
export GOFLAGS := -buildvcs=false

%:
	dh $@

# Fail here with a clear message instead of deep inside the build.
# THIRD-PARTY-NOTICES is committed so that the build needs no extra network
# access; the check keeps it from drifting away from go.mod unnoticed.
execute_before_dh_auto_configure:
	$(GO) version
	$(GO) mod verify
	sh packaging/gen-notices.sh debian/notices.check
	cmp debian/notices.check THIRD-PARTY-NOTICES || { \
		echo "THIRD-PARTY-NOTICES is out of date; run: bash packaging/gen-notices.sh"; \
		false; }

override_dh_auto_build:
	$(GO) build -trimpath -ldflags="-s -w" -o bin/ssh-gate .

override_dh_auto_test:
	$(GO) test ./...

override_dh_auto_install:
	install -D -m 0755 bin/ssh-gate debian/tmp/usr/bin/ssh-gate
	install -D -m 0644 debian/ssh-gate.config.yaml debian/tmp/etc/ssh-gate/config.yaml
	install -D -m 0644 debian/rsyslog.conf debian/tmp/etc/rsyslog.d/40-ssh-gate.conf

override_dh_auto_clean:
	rm -rf bin debian/notices.check

# The binary is linked with -s -w, so there is no debug info for dwz to
# compress and nothing for dh_strip to collect.
override_dh_dwz:

override_dh_strip:
	dh_strip --no-automatic-dbgsym

# The service starts on a fresh install too: with an empty ssh.servers list,
# direct routes remain available while the operator configures the tunnel. On
# upgrade the debhelper snippet restarts it (a plain restart, so a service the
# 0.1.0 prerm stopped comes back as well).
#
# Older debhelper versions install the unit under /lib. Move it after the
# maintainer snippets are generated so all packages use the canonical path.
override_dh_installsystemd:
	dh_installsystemd
	if [ -f debian/ssh-gate/lib/systemd/system/ssh-gate.service ]; then \
		mkdir -p debian/ssh-gate/usr/lib/systemd/system && \
		mv debian/ssh-gate/lib/systemd/system/ssh-gate.service debian/ssh-gate/usr/lib/systemd/system/ && \
		rmdir --ignore-fail-on-non-empty -p debian/ssh-gate/lib/systemd/system; \
	fi
	test -f debian/ssh-gate/usr/lib/systemd/system/ssh-gate.service
