# VPS access
SSH_HOST=
SSH_PORT=22
SSH_USER=

# Max duration of a single destination dial through the tunnel (Go duration,
# must be positive and below 10m — the connection history window). A dial to
# a blackholed host fails with a deadline error instead of hanging; default 30s.
SSH_DIAL_TIMEOUT=30s

# Proxy modes: socks5, mtproto, http (comma-separated)
PROXY_MODES=socks5,mtproto

# Listen addresses (inside container)
SOCKS5_LISTEN=0.0.0.0:1080
MTPROTO_LISTEN=0.0.0.0:20443
HTTP_LISTEN=0.0.0.0:3128

# Health + Web UI listen address (inside container; default 127.0.0.1:9090).
# Compose sets 0.0.0.0:9090 inside the container and maps it to host loopback.
HEALTH_LISTEN=127.0.0.1:9090

# Direct routing rules (optional, comma-separated)
# Example: DIRECT_RULES=re:\\.ru$,ip:10.0.0.0/8,internal.local
DIRECT_RULES=

# Direct dial IP family: ipv4, ipv6, both
DIRECT_IP_FAMILY=ipv4

# DNS-over-HTTPS server IP
DOH_IP=9.9.9.9

# Log level: debug, info, warn, error
LOG_LEVEL=warn

# TCP keepalive for the SSH tunnel (Go duration). 0 disables OS keepalive.
# Detects silent (half-open) dead paths through NAT/firewall; default 90s.
SSH_KEEPALIVE_PERIOD=90s
