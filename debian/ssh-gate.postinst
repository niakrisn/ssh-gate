#!/bin/sh
set -e

#DEBHELPER#

if [ "$1" != configure ]; then
	exit 0
fi

if [ -s /etc/default/ssh-gate ]; then
	echo "ssh-gate: the old /etc/default/ssh-gate environment file is no longer read."
	echo "ssh-gate: migrate its values to /etc/ssh-gate/config.yaml; see /usr/share/doc/ssh-gate/README.md and config.example.yaml."
fi

if ! grep -Eq '^[[:space:]]*servers:[[:space:]]*\[' /etc/ssh-gate/config.yaml 2>/dev/null && \
	! grep -Eq '^[[:space:]]*- id:' /etc/ssh-gate/config.yaml 2>/dev/null; then
	echo "ssh-gate: add entries under ssh.servers in /etc/ssh-gate/config.yaml, then restart the service."
fi

exit 0
